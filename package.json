{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4",
    "ios_saf 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:mdx": "node --test scripts/check-mdx.test.mjs && node scripts/check-mdx.mjs",
    "test:popular-posts": "node --test scripts/popular-posts.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm lint:styles && pnpm lint:mdx && pnpm test:popular-posts && pnpm typecheck && pnpm format:check",
    "verify": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "sass": "1.106.1",
    "stylelint": "17.16.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3"
  }
}
