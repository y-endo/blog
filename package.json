{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm format:check",
    "verify": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@shikijs/rehype": "4.4.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "sass": "1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3"
  }
